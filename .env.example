# identity-service 로컬 실행용 환경변수 예시.
#   cp .env.example .env  후 값을 채운다. .env 는 커밋하지 않는다.
#
# 여기 담는 것은 "환경마다 바뀌는 값"만이다.
# flyway 스키마(identity), JWT issuer 기본값 등 서비스 고유 고정값은 application.yml 에 있다.

# --- 프로필 ---
# dev: 콘솔 로그 + swagger. prod: 파일 로그만 + JWT_SECRET 필수.
SPRING_PROFILES_ACTIVE=dev

# --- 포트 ---
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=9091

# --- PostgreSQL (identity 스키마는 Flyway 가 자동 생성) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/travel_diary_dev
SPRING_DATASOURCE_USERNAME=travel_diary
SPRING_DATASOURCE_PASSWORD=travel_diary_password

# --- Redis (one-time token / OAuth state 저장) ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# --- JWT (HS256, 최소 32 bytes. 4개 서비스가 동일 값을 공유해야 토큰이 상호 통용) ---
JWT_SECRET=local-development-jwt-secret-change-me-please
# 아래는 application.yml 기본값이 있어 생략 가능
# JWT_ISSUER=identity-service
# JWT_ACCESS_TOKEN_TTL=30m

# --- 로그 파일 경로 ---
# dev 기본값은 /app 기준 상대경로(logs/identity-service.log)라 비루트 컨테이너에서는 못 쓴다.
# 컨테이너로 띄울 때는 절대경로로 오버라이드한다.
# LOGGING_FILE_NAME=/var/log/identity-service/identity-service.log

# --- 서비스 간 호출 ---
# identity -> travel (회원 탈퇴 시 여행 데이터 정리 요청)
TRAVEL_SERVICE_BASE_URL=http://localhost:8085

# --- CORS / OAuth 리다이렉트 ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
OAUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000
OAUTH_FRONTEND_REDIRECT_URL=http://localhost:3000/auth/callback

# --- OAuth 공급자 (로컬에서 실제 로그인 테스트할 때만 채운다) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/google/callback
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/naver/callback

# --- 프로필 이미지 저장소 (S3) — 로컬에서는 비활성 ---
PROFILE_IMAGE_STORAGE_ENABLED=false
